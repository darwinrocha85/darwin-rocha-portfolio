{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["node scripts/generate-agent-context.mjs"],
    "rewrites": [
      {
        "source": "/api/ask",
        "function": "ask"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": ["node scripts/generate-agent-context.mjs"]
  },
  "emulators": {
    "functions": { "port": 5002 },
    "hosting": { "port": 5000 }
  }
}
